---
import Layout from "../layouts/Layout.astro";
---

<Layout title="sayoi341.moe — インターネットの、片すみに。">
  <a class="skip-link" href="#main">本文へスキップ</a>
  <div class="page-shell" id="top">
    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="sayoi341.moe ホーム">sayoi341<span>.moe</span><span class="brand-dot" aria-hidden="true"></span></a>
      <nav aria-label="メインナビゲーション">
        <a href="#about">この場所について</a>
        <a href="#links">リンク <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="small-star" aria-hidden="true">✳</span> A SMALL CORNER OF THE INTERNET</p>
          <h1 id="hero-title">インターネットの、<br /><span>片すみに。</span></h1>
          <p class="intro">ようこそ、sayoi341 のホームページへ。<br />ひと息ついて、ゆっくり見ていってください。</p>
          <a class="button" href="#about">この場所をのぞいてみる <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-art" aria-hidden="true">
          <div class="art-top"><span>sayoi341.moe</span><span>HOME / 01</span></div>
          <svg class="orbit-art" viewBox="0 0 480 420" fill="none">
            <defs>
              <linearGradient id="planet" x1="130" y1="95" x2="340" y2="330" gradientUnits="userSpaceOnUse">
                <stop stop-color="#e8e0fa" /><stop offset=".54" stop-color="#b4a0d5" /><stop offset="1" stop-color="#79629e" />
              </linearGradient>
              <radialGradient id="glow"><stop stop-color="#fff" stop-opacity=".85" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></radialGradient>
              <clipPath id="sphere-clip"><circle cx="242" cy="205" r="112" /></clipPath>
            </defs>
            <path d="M52 205H428M242 28V382" stroke="#c8bed8" stroke-dasharray="3 7" />
            <ellipse cx="242" cy="205" rx="198" ry="73" transform="rotate(-32 242 205)" stroke="#8974a8" />
            <circle cx="242" cy="205" r="112" fill="url(#planet)" />
            <g clip-path="url(#sphere-clip)" stroke="#f4efff" stroke-opacity=".4">
              <ellipse cx="242" cy="205" rx="48" ry="112" transform="rotate(-28 242 205)" />
              <ellipse cx="242" cy="205" rx="85" ry="112" transform="rotate(-28 242 205)" />
              <ellipse cx="242" cy="205" rx="112" ry="35" transform="rotate(-28 242 205)" />
              <ellipse cx="242" cy="205" rx="112" ry="77" transform="rotate(-28 242 205)" />
            </g>
            <circle cx="210" cy="155" r="94" fill="url(#glow)" />
            <path d="M74 275C108 302 202 285 280 237S414 136 410 111" stroke="#65517f" stroke-width="2" />
            <circle cx="393" cy="128" r="13" fill="#d3eb9b" stroke="#f4f2f8" stroke-width="4" />
            <path d="M119 76V102M106 89H132M371 309V327M362 318H380" stroke="#796590" stroke-width="2" />
            <circle cx="111" cy="318" r="4" fill="#796590" />
            <circle cx="356" cy="63" r="3" fill="#796590" />
          </svg>
          <div class="art-bottom"><span class="art-caption">小さな場所から、ひろい世界へ。</span><span class="art-spark">✳</span></div>
        </div>
        <div class="hero-bottom"><span>PERSONAL WEBSITE</span><a href="#about">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a></div>
      </section>

      <section class="about section" id="about" aria-labelledby="about-title">
        <div class="section-label"><span>01 / ABOUT</span><span class="small-star" aria-hidden="true">✳</span></div>
        <div class="about-content">
          <h2 id="about-title">ここが、<br />ウェブでの<span class="highlight">入り口。</span></h2>
          <div class="about-text">
            <p>sayoi341.moe は、sayoi341 のホームページです。</p>
            <p>広いインターネットのなかで、名前をたよりに<br class="desktop-break" />たどり着ける、小さな場所。<br />GitHub へのリンクも、ここにまとめています。</p>
            <p class="quiet-note"><span aria-hidden="true">↳</span> 見つけてくれて、ありがとうございます。</p>
          </div>
        </div>
      </section>

      <section class="links section" id="links" aria-labelledby="links-title">
        <div class="section-label"><span>02 / ELSEWHERE</span><span aria-hidden="true">↗</span></div>
        <div class="links-heading"><h2 id="links-title">ここから、つながる。</h2><p>ウェブの向こう側へ。</p></div>
        <a class="github-link" href="https://github.com/sayoi341">
          <span class="github-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.18-3.37-1.18-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03a9.6 9.6 0 0 1 5 0c1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.85-2.34 4.7-4.58 4.95.36.31.68.92.68 1.85v2.59c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg></span>
          <span class="github-copy"><span class="link-kicker">CODE & REPOSITORIES</span><span class="link-title">GitHub <span>@sayoi341</span></span><span class="link-description">公開リポジトリやプロフィールを見る</span></span>
          <span class="link-arrow" aria-hidden="true">↗</span>
        </a>
      </section>
      <div class="closing"><span aria-hidden="true">✳</span><p>また、どこかで。<span>See you around the web.</span></p><a href="#top" aria-label="ページの先頭へ戻る">↑</a></div>
    </main>
    <footer><a href="#top">sayoi341.moe</a><span>この小さな場所から。</span><span>© {new Date().getFullYear()} sayoi341</span></footer>
  </div>
</Layout>

<style>
  .page-shell { max-width: 1440px; padding: 0 6.25%; margin: auto; }
  .skip-link { position: fixed; top: 12px; left: 12px; transform: translateY(-160%); z-index: 10; padding: 12px 20px; background: #d3eb9b; }
  .skip-link:focus { transform: none; }
  .site-header { display: flex; align-items: center; justify-content: space-between; min-height: 110px; border-bottom: 1px solid var(--line); gap: 24px; }
  .wordmark { font-family: ui-monospace, monospace; font-size: 23px; letter-spacing: -.9px; font-weight: 700; text-decoration: none; display: flex; align-items: center; }
  .wordmark > span:first-child { color: var(--muted); font-weight: 400; }
  .brand-dot { width: 8px; height: 8px; background: #8976ac; border-radius: 50%; margin-left: 10px; }
  nav { display: flex; gap: 32px; font-size: 13px; }
  nav a { text-decoration: none; padding: 12px 0; }
  nav a:hover { color: var(--purple); text-decoration: underline; }
  nav a span { margin-left: 8px; }
  .hero { display: grid; grid-template-columns: 1.15fr 1fr; column-gap: 4%; align-items: center; padding-top: 74px; }
  .eyebrow, .section-label, .hero-bottom, .art-top, .link-kicker { font-family: ui-monospace, monospace; letter-spacing: .08em; font-size: 11px; }
  .eyebrow { display: flex; align-items: center; gap: 10px; color: var(--purple); margin: 0 0 29px; }
  .small-star { font-size: 23px; line-height: 1; }
  h1 { font-size: clamp(33px, 3.7vw, 54px); line-height: 1.6; letter-spacing: -.055em; font-weight: 600; margin: 0; }
  h1 > span { color: var(--purple); }
  .intro { font-size: 14px; line-height: 2.1; margin: 24px 0 30px; color: var(--muted); }
  .button { display: inline-flex; align-items: center; justify-content: space-between; gap: 27px; padding: 17px 24px; background: #30293f; color: #fff; border-radius: 100px; text-decoration: none; font-size: 12px; transition: background .2s, transform .2s; }
  .button:hover { background: #68509b; transform: translateY(-2px); }
  .hero-art { position: relative; background: #eae5f2; border: 1px solid #ded6ea; border-radius: 180px 180px 14px 14px; padding: 40px 26px 19px; overflow: hidden; }
  .art-top, .art-bottom { display: flex; justify-content: space-between; align-items: center; color: #625273; }
  .art-top { justify-content: center; gap: 24px; font-size: 9px; }
  .orbit-art { display: block; width: 118%; max-width: none; margin: 0 -9%; }
  .art-caption { font-size: 11px; letter-spacing: .08em; }
  .art-spark { font-size: 28px; }
  .hero-bottom { grid-column: 1 / -1; display: flex; justify-content: space-between; color: var(--muted); padding: 53px 0 28px; font-size: 9px; }
  .hero-bottom a { text-decoration: none; }
  .hero-bottom a span { margin-left: 12px; }
  .section { border-top: 1px solid var(--line); padding: 30px 0 70px; scroll-margin-top: 24px; }
  .section-label { display: flex; justify-content: space-between; align-items: center; color: var(--purple); }
  .about-content { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; padding-top: 46px; }
  h2 { font-weight: 500; font-size: clamp(26px, 2.8vw, 38px); line-height: 1.75; letter-spacing: -.045em; margin: 0; }
  .highlight { background: linear-gradient(transparent 62%, #d9e9b8 62%, #d9e9b8 90%, transparent 90%); }
  .about-text { font-size: 13px; line-height: 2.2; padding-top: 2px; }
  .about-text p { margin: 0 0 17px; }
  .about-text .quiet-note { font-size: 11px; color: var(--muted); margin-top: 26px; margin-bottom: 0; }
  .quiet-note span { margin-right: 7px; }
  .links-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin: 34px 0 29px; }
  .links-heading p { font-size: 12px; color: var(--muted); }
  .github-link { display: flex; align-items: center; gap: 26px; border: 1px solid #d4ccdf; background: #ece8f3; padding: 30px 34px; border-radius: 9px; text-decoration: none; transition: background .2s; }
  .github-link:hover { background: #e2daee; }
  .github-icon { display: grid; place-items: center; height: 62px; width: 62px; flex-shrink: 0; border: 1px solid #cfc5dd; border-radius: 50%; }
  .github-icon svg { width: 28px; height: 28px; }
  .github-copy { display: grid; gap: 7px; }
  .link-kicker { color: var(--muted); font-size: 9px; }
  .link-title { font-size: 27px; font-weight: 500; letter-spacing: -.04em; }
  .link-title span { font-family: ui-monospace, monospace; font-size: 13px; color: var(--muted); margin-left: 15px; letter-spacing: -.02em; }
  .link-description { font-size: 11px; color: var(--muted); }
  .link-arrow { display: grid; place-items: center; background: #d5e9ae; border-radius: 50%; width: 44px; height: 44px; font-size: 23px; margin-left: auto; flex-shrink: 0; transition: transform .2s; }
  .github-link:hover .link-arrow { transform: rotate(45deg); }
  .closing { display: flex; align-items: center; gap: 20px; padding: 6px 0 62px; }
  .closing > span { font-size: 42px; color: #9580b4; }
  .closing p { font-size: 17px; margin: 0; letter-spacing: .03em; }
  .closing p span { display: block; font-family: ui-monospace, monospace; font-size: 10px; color: var(--muted); margin-top: 8px; }
  .closing a { margin-left: auto; text-decoration: none; padding: 10px 16px; border: 1px solid var(--line); border-radius: 50%; }
  footer { display: flex; justify-content: space-between; gap: 20px; padding: 25px 0 29px; border-top: 1px solid var(--line); color: var(--muted); font-size: 10px; }
  footer a { font-family: ui-monospace, monospace; text-decoration: none; color: #292537; }
  @media (min-width: 1440px) { h1 { font-size: 54px; } }
  @media (max-width: 760px) {
    .page-shell { padding: 0 6%; }
    .site-header { min-height: 86px; }
    .wordmark { font-size: 19px; }
    nav { gap: 18px; font-size: 11px; }
    .hero { grid-template-columns: 1fr; padding-top: 48px; }
    .eyebrow { font-size: 9px; margin-bottom: 22px; }
    h1 { font-size: clamp(32px, 7.3vw, 52px); }
    .intro { font-size: 13px; margin: 20px 0 26px; }
    .hero-art { margin: 38px auto 0; width: min(100%, 410px); padding-top: 35px; }
    .hero-bottom { padding-top: 30px; font-size: 8px; }
    .section { padding-bottom: 45px; }
    .about-content { grid-template-columns: 1fr; gap: 22px; padding-top: 28px; }
    .about-text { font-size: 13px; }
    .links-heading { display: block; margin-top: 27px; }
    .links-heading p { margin: 10px 0 0; }
    .github-link { padding: 22px 17px; gap: 15px; }
    .github-icon { width: 44px; height: 44px; }
    .github-icon svg { width: 24px; height: 24px; }
    .link-title { font-size: 23px; }
    .link-title span { display: block; margin: 5px 0 0; font-size: 11px; }
    .link-description { font-size: 10px; line-height: 1.8; }
    .link-kicker { font-size: 8px; }
    .link-arrow { width: 34px; height: 34px; font-size: 19px; }
    .closing { padding-bottom: 42px; }
    footer { flex-wrap: wrap; gap: 16px; }
    footer > span:nth-child(2) { display: none; }
  }
  @media (max-width: 360px) {
    .site-header { gap: 12px; }
    .wordmark { font-size: 17px; }
    nav { gap: 12px; font-size: 10px; }
    .github-link { gap: 10px; padding: 20px 12px; }
    .github-icon { display: none; }
  }
</style>
